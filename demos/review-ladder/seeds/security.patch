+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+
+/**
+ * Builds the Device search for the patient in the /Patient/:id/devices route.
+ * @param patientId - The :id route param.
+ * @returns The search query string.
+ */
+export function buildDeviceSearch(patientId: string): string {
+  return 'patient=Patient/' + patientId + '&_count=100';
+}
