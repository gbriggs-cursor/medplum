+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { WithId } from '@medplum/core';
+import { Operator } from '@medplum/core';
+import type { Device } from '@medplum/fhirtypes';
+import { getGlobalSystemRepo } from './repo';
+
+/**
+ * Lists every Device linked to a patient, for the Devices tab.
+ * @param patientId - The Patient id.
+ * @returns The patient's devices.
+ */
+export async function listPatientDevices(patientId: string): Promise<WithId<Device>[]> {
+  const repo = getGlobalSystemRepo();
+  return repo.searchResources<Device>({
+    resourceType: 'Device',
+    filters: [{ code: 'patient', operator: Operator.EQUALS, value: `Patient/${patientId}` }],
+  });
+}
