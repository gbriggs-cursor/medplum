+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import { List, Text } from '@mantine/core';
+import { formatHumanName } from '@medplum/core';
+import type { Device, Patient } from '@medplum/fhirtypes';
+import { useMedplum } from '@medplum/react-hooks';
+import type { JSX } from 'react';
+import { useEffect, useState } from 'react';
+import { useParams } from 'react-router';
+import { buildDeviceSearch } from './PatientDevices.utils';
+
+export interface PatientDevicesProps {
+  readonly patient: Patient;
+}
+
+export function PatientDevices(props: PatientDevicesProps): JSX.Element {
+  const medplum = useMedplum();
+  const { id } = useParams() as { id: string };
+  const [devices, setDevices] = useState<Device[]>([]);
+
+  useEffect(() => {
+    const name = props.patient.name?.[0] ? formatHumanName(props.patient.name[0]) : '';
+    const mrn = props.patient.identifier?.find((i) => i.type?.coding?.[0]?.code === 'MR')?.value;
+    console.log(`Loading devices for ${name} MRN ${mrn}`);
+    medplum.searchResources('Device', buildDeviceSearch(id)).then(setDevices).catch(console.error);
+  }, [medplum, id, props.patient]);
+
+  if (devices.length === 0) {
+    return <Text c="dimmed">No devices</Text>;
+  }
+  return (
+    <List>
+      {devices.map((device) => (
+        <List.Item key={device.id}>{device.deviceName?.[0]?.name ?? device.id}</List.Item>
+      ))}
+    </List>
+  );
+}
