+
+const DEVICE_SYNC_CLIENT_ID = '6f1c2a4e-0d5b-4c7e-9a3f-1b2c3d4e5f60';
+const DEVICE_SYNC_CLIENT_SECRET = 'DEMO-NOT-A-REAL-SECRET';
+
+/**
+ * Signs the device sync client in so it can pull readings from home devices.
+ * @param medplum - The Medplum client.
+ */
+export async function startDeviceSync(medplum: MedplumClient): Promise<void> {
+  await medplum.startClientLogin(DEVICE_SYNC_CLIENT_ID, DEVICE_SYNC_CLIENT_SECRET);
+}
