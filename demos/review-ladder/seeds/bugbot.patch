+/**
+ * Builds the Observation search for one device's readings over the last 30 days.
+ * @param deviceId - The Device id.
+ * @param now - The current time.
+ * @returns The search query string.
+ */
+export function getDeviceObservationSearch(deviceId: string, now = new Date()): string {
+  const start = new Date(now);
+  start.setUTCDate(start.getUTCDate() - 30);
+  const day0 = start.toISOString().slice(0, 10);
+  return `device=Device/${deviceId}&date=gt${day0}&_sort=date&_count=200`;
+}
